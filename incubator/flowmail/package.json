  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx server/seed.ts",
    "verify-architecture": "tsx scripts/verify-architecture.ts",
    "create-feature": "tsx scripts/create-feature.ts",
    "validate": "npm run lint && npm run format:check && npm run check && npm run test",
    "ci": "npm run lint && npm run format:check && npm run check && npm run build && npm run test",
    "test:coverage": "vitest --coverage --run"
  },
