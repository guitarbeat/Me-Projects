{
  "name": "me-projects",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/flo-and-tell",
    "apps/lenticular-lab",
    "apps/nini-earth",
    "apps/scanforge",
    "apps/harmonic-studio",
    "incubator/flowmail",
    "packages/ui"
  ],
  "scripts": {
    "dev:flowmail": "npm run dev --workspace=incubator/flowmail",
    "dev:flo-and-tell": "npm run dev --workspace=apps/flo-and-tell",
    "dev:lenticular-lab": "npm run dev --workspace=apps/lenticular-lab",
    "dev:nini-earth": "npm run dev --workspace=apps/nini-earth",
    "dev:scanforge": "npm run dev --workspace=apps/scanforge",
    "dev:harmonic-studio": "npm run dev --workspace=apps/harmonic-studio",
    "install:all": "npm install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:flo-and-tell": "npm run lint --workspace=apps/flo-and-tell",
    "test:flo-and-tell": "npm test --workspace=apps/flo-and-tell"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod-validation-error": "3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
